# Copy to backend/.env for local runs, or set these as environment variables in your host.
ENVIRONMENT=development            # production enforces OIDC, https PUBLIC_URL and a strong SECRET_KEY
PUBLIC_URL=http://localhost:5173   # browser-facing URL (the Vite dev server in local dev)
SECRET_KEY=change-me-to-64-random-characters
DATABASE_URL=sqlite:///./switchyard.db   # or postgresql+psycopg://user:pass@host:5432/switchyard

AUTH_MODE=dev                      # dev | oidc
ADMIN_EMAILS=                      # break-glass admins, comma separated
OIDC_PROVIDER_NAME=Microsoft Entra ID
OIDC_DISCOVERY_URL=                # https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_GROUPS_CLAIM=groups           # Entra app roles: roles

SEED_DEMO=true                     # demo endpoints + workflow on first start
DEMO_MCP_URL=http://localhost:9100
MCP_TIMEOUT_S=60
MCP_VERIFY_TLS=true
